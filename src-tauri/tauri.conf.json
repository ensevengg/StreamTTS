{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamTTS",
  "version": "2.0.0",
  "identifier": "com.nerve.streamtts",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StreamTTS",
        "width": 1024,
        "height": 768,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#1a1a1a",
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.twitch.tv https://www.googleapis.com https://api.elevenlabs.io wss://irc-ws.chat.twitch.tv; object-src 'none'; base-uri 'none'; form-action 'self'"
    },

    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "singleInstance": {
      "enabled": true
    },
    "updater": {
      "active": true,
      "endpoints": ["https://mananjk.github.io/StreamTTS/update.json"],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU4RDQzNTE3NzMwMEYxNzkKUldSNThRQnpGelhVNkRkNStCdUVyUDJqZ3hBNk9KNnhXeWpCWW5lQi81SWtXVzQwVmFhcDFhOEcK"
    }
  }
}
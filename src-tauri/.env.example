# YouTube OAuth Credentials
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
YOUTUBE_CLIENT_ID=your-client-id-here
YOUTUBE_CLIENT_SECRET=your-client-secret-here

# Twitch Client ID (used for authorization-code exchange and token refresh)
# Falls back to VITE_TWITCH_CLIENT_ID if not set here.
TWITCH_CLIENT_ID=your-twitch-client-id-here

# Optional: Twitch Client Secret. Token exchange works without it (PKCE),
# but access-token refresh is more reliable when it is configured.
# TWITCH_CLIENT_SECRET=your-twitch-client-secret

# Twitch EventSub Webhook Secret
# No longer configured here: the app generates a random per-install secret on
# first launch and stores it in the OS app-data directory.

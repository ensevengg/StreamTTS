# OAuth client configuration. src-tauri/build.rs compiles these values into
# the desktop binary, so installed copies of StreamTTS need no .env file.
# None of them is exposed to the webview (no VITE_ prefix).

# Twitch application: https://dev.twitch.tv/console
# Set "Client Type" to Public. StreamTTS signs in with Twitch's Device Code
# Flow, which needs no client secret and no OAuth redirect URL.
TWITCH_CLIENT_ID=your-twitch-client-id

# Google OAuth client: https://console.cloud.google.com/apis/credentials
# Create an OAuth client of type "Desktop app" and enable the YouTube Data API
# v3. Google treats a desktop client's secret as non-confidential, so it is
# compiled into the app. Only the read-only youtube.readonly scope is used.
YOUTUBE_CLIENT_ID=your-youtube-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-client-secret
